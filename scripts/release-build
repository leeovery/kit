#!/usr/bin/env bash
#
# Builds a release's binaries on this Mac before mint tags it: mint's pre_tag
# runs it after scripts/gates, with the version about to be tagged in
# MINT_NEW_VERSION. It builds HEAD in a checkout of its own outside the
# repository: first kit's Mac app, kit.app, one binary for arm64 and x86_64,
# laid out by cmd/kitapp with the version in its Info.plist, and signed with
# this Mac's Developer ID and the hardened runtime; then kit for arm64 and
# amd64, checking each reports the version. It sends kit.app to Apple's
# notary service and waits on its answer, for about an hour at most, staples
# Apple's ticket to it and checks it as Gatekeeper does. Then it archives
# each kit with kit.app beside it, and sums them, under the names install.sh
# and the Homebrew formula read, and keeps them, with the commit built, in
# ~/Library/Caches/kit/release/<version>/, in place of any other version's,
# for scripts/release-upload once the release is made. A tree made before
# kit.app shipped, without cmd/kitapp, is built as it was, kit alone. Any
# failure exits non-zero, so mint stops before the tag. It runs each binary
# to check its version, so it needs an Apple-silicon Mac with Rosetta.
#
# By hand it builds the version given, as scripts/release-build 0.0.0-check,
# which checks signing and notarising without releasing anything; a ref
# after the version builds that ref, as scripts/release-upload builds a
# tag's tree. Each run logs to ~/Library/Logs/kit/release-<version>.log.
set -euo pipefail

scripts=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
# shellcheck source=scripts/release-common
. "$scripts/release-common"

bundle_id=com.leeovery.kit
identity="Developer ID Application"
# The signing keychain, which kit's developer-id step makes, holds the
# Developer ID identity and notarytool's profile. It opens with the .p12's
# password, DEVELOPER_ID_P12_PASSWORD, which kit writes to ~/.secrets.zsh, so
# release-build unlocks it itself and asks nothing, at the Mac or over SSH.
# Every codesign and notarytool call names it, and kit's step puts it first
# on the keychain search list, where codesign finds the key whatever
# --keychain names.
keychain=$HOME/Library/Keychains/signing.keychain-db
# notarytool's login is the Mac's, whatever it notarises, so its profile is
# named for notarytool, not for kit.
profile=notarytool
# How every notarytool call signs in: the profile, in the signing keychain.
notary=(--keychain "$keychain" --keychain-profile "$profile")
# What a command handed to a person runs first, so it opens the signing
# keychain in any shell, one that hasn't read ~/.secrets.zsh among them: it
# reads the password from that file, naming the variable, never its value.
unlock_command="source ~/.secrets.zsh && security unlock-keychain -p \"\$DEVELOPER_ID_P12_PASSWORD\" $keychain"
# notarytool waits on Apple this many seconds at a time, this many times at
# most, so mint, which gives a hook no time limit, waits about an hour.
notary_wait=900
notary_waits=4
# What codesign's failure adds, its command reading the password from
# ~/.secrets.zsh as unlock_command's does.
keychain_hint="macOS may be asking on the Mac's screen to let codesign use the signing keychain's key: source ~/.secrets.zsh && security set-key-partition-list -S apple-tool:,apple:,codesign: -s -k \"\$DEVELOPER_ID_P12_PASSWORD\" $keychain lets codesign use it with no dialog."
# kit.app's arches, as swiftc names them, and the oldest macOS it runs on,
# Go's own oldest, so no kit runs where its app can't.
app_arches=(arm64 x86_64)
app_macos=12
# The Developer ID's team, which check_identity reads from its name.
team=
work=

usage() {
	release_fail "Usage: scripts/release-build [<version> [<ref>]]"
}

check_platform() {
	[[ $(uname -s) == Darwin ]] || release_fail "release-build signs with macOS's codesign and notarytool, and runs the binaries it builds, for macOS, to check them: run it on a Mac."
}

check_version() {
	[[ -n $1 ]] || release_fail "No version to build: mint gives it as MINT_NEW_VERSION; by hand, give it, as scripts/release-build 0.0.0-check."
	release_valid_version "$1" || release_fail "$1 isn't a version, as 1.2.3 or 1.2.3-check."
}

# check_head checks that HEAD is what mint is about to tag $1 on: tracked
# files with nothing uncommitted, as untracked ones never reach a build of
# the commit, and no tag $1 yet.
check_head() {
	[[ -z $(git status --porcelain --untracked-files=no) ]] || release_fail "The checkout has changes: release-build builds HEAD, so commit or remove them."
	if git rev-parse -q --verify "refs/tags/$1" >/dev/null; then
		release_fail "$1 is tagged already, so HEAD isn't what's to be tagged: build the tag, as scripts/release-build ${1#v} $1."
	fi
}

# commit_of is the commit ref $1 names.
commit_of() {
	git rev-parse -q --verify "$1^{commit}" || release_fail "$1 names no commit to build."
}

# unlock_keychain unlocks the signing keychain with its password, so nothing
# that signs or notarises asks for it.
unlock_keychain() {
	[[ -f $keychain ]] || release_fail "There's no signing keychain at $keychain: kit apply makes it, its developer-id step."
	# The environment's password first, then ~/.secrets.zsh's where it differs:
	# a shell that hasn't read the file, as a plain ssh command's, an agent's or
	# one started before kit wrote it, has none, and one started before the
	# password changed has the old one.
	local from_file=
	if [[ -f $HOME/.secrets.zsh ]]; then
		from_file=$(zsh -fc 'source ~/.secrets.zsh && print -rn -- "${DEVELOPER_ID_P12_PASSWORD-}"') || from_file=
	fi
	[[ -n ${DEVELOPER_ID_P12_PASSWORD:-} || -n $from_file ]] || release_fail "DEVELOPER_ID_P12_PASSWORD isn't set, nor in ~/.secrets.zsh, so the signing keychain can't be unlocked: kit secret sync writes it to ~/.secrets.zsh."
	if [[ -z ${DEVELOPER_ID_P12_PASSWORD:-} ]] || ! security unlock-keychain -p "$DEVELOPER_ID_P12_PASSWORD" "$keychain" 2>/dev/null; then
		if [[ -z $from_file || $from_file == "${DEVELOPER_ID_P12_PASSWORD:-}" ]] || ! security unlock-keychain -p "$from_file" "$keychain" 2>/dev/null; then
			release_fail "The signing keychain doesn't open with DEVELOPER_ID_P12_PASSWORD, the environment's or ~/.secrets.zsh's: kit status developer-id says whether the password or the keychain is wrong, and what to do."
		fi
		DEVELOPER_ID_P12_PASSWORD=$from_file
	fi
	# Behind a keychain holding the same identity, as the login keychain may,
	# codesign takes that one's key, locked over SSH.
	[[ $(security list-keychains -d user | head -n 1 | sed 's/^ *"//; s/"$//') == "$keychain" ]] ||
		release_fail "The signing keychain isn't first on the keychain search list, where codesign finds its key whatever --keychain names: kit apply puts it there, its developer-id step."
}

# check_identity checks the signing keychain has one Developer ID to sign
# kit.app with, and reads its team from its name, as "Developer ID
# Application: Name (ABCDE12345)".
check_identity() {
	local found count
	found=$(security find-identity -v -p codesigning "$keychain" | grep "\"$identity: ") || true
	count=$(grep -c . <<<"$found") || true
	case $count in
	0) release_fail "The signing keychain has no valid $identity certificate to sign kit.app with: kit apply imports it, its developer-id step." ;;
	1) ;;
	*) release_fail "The signing keychain has $count valid $identity certificates, and codesign can't choose one: remove all but one." ;;
	esac
	team=$(sed -E 's/.*\(([A-Z0-9]+)\)"$/\1/' <<<"$found")
	[[ $team =~ ^[A-Z0-9]{10}$ ]] || release_fail "The $identity certificate's name ends in no team, as (ABCDE12345): $found"
}

check_profile() {
	if ! xcrun notarytool history "${notary[@]}" >/dev/null; then
		release_fail "notarytool can't use the keychain profile $profile in the signing keychain, as it says above. If the profile isn't made, kit apply makes it, its notarytool step; no network fails the same way."
	fi
}

# arch_flag is arch(1)'s name for Go's arch $1.
arch_flag() {
	case $1 in
	amd64) echo x86_64 ;;
	*) echo "$1" ;;
	esac
}

# build builds version $2 from the checkout $1 for arch $3 into $4. -trimpath
# keeps this Mac's paths, its home's module cache among them, out of a public
# binary.
build() {
	(cd "$1" && CGO_ENABLED=0 GOOS=darwin GOARCH=$3 go build -trimpath \
		-ldflags "-s -w -X main.version=$2" -o "$4" ./cmd/kit)
}

# build_app builds kit.app at version $2 from the checkout $1 into the folder
# $3: laid out by the checkout's cmd/kitapp, its executable compiled for each
# arch and joined, then signed with the Developer ID and the hardened
# runtime.
build_app() {
	local app=$3/kit.app arch thin=()
	(cd "$1" && go run ./cmd/kitapp "$app" "$2" "$team") || release_fail "cmd/kitapp couldn't lay kit.app out, as it says above."
	for arch in "${app_arches[@]}"; do
		swiftc -O -target "$arch-apple-macos$app_macos" -o "$3/kit-$arch" "$1/internal/macapp/kit.swift" ||
			release_fail "swiftc couldn't compile kit.app for $arch, as it says above."
		thin+=("$3/kit-$arch")
	done
	lipo -create -output "$app/Contents/MacOS/kit" "${thin[@]}"
	rm -f "${thin[@]}"
	codesign --force --options runtime --timestamp --keychain "$keychain" --sign "$identity" "$app" ||
		release_fail "codesign couldn't sign $app, as it says above. $keychain_hint"
	check_signature "$app"
}

# check_signature checks that the app $1 is signed as kit.app by the
# Developer ID of the team read, with the hardened runtime.
check_signature() {
	local details
	codesign --verify --strict "$1" || release_fail "$1's signature doesn't verify."
	details=$(codesign --display --verbose=2 "$1" 2>&1)
	if ! grep -qx "Identifier=$bundle_id" <<<"$details" ||
		! grep -q "^Authority=$identity: " <<<"$details" ||
		! grep -qx "TeamIdentifier=$team" <<<"$details" ||
		! grep -q "^CodeDirectory .*(runtime)" <<<"$details"; then
		echo "$details"
		release_fail "$1 isn't signed as $bundle_id by the $identity of team $team, with the hardened runtime."
	fi
}

# cant_run says why the binary $1, built for arch $2, doesn't run here, and
# what puts that right, and stops.
cant_run() {
	if [[ $(sysctl -in hw.optional.arm64) != 1 ]]; then
		release_fail "$1 doesn't run on this Intel Mac, so its version can't be checked: a release needs an Apple-silicon Mac with Rosetta."
	fi
	if [[ $2 == amd64 ]] && ! arch -x86_64 /usr/bin/true 2>/dev/null; then
		release_fail "$1 needs Rosetta to run, so its version can't be checked: install it with softwareupdate --install-rosetta --agree-to-license."
	fi
	release_fail "$1 doesn't run here, so its version can't be checked."
}

# check_binary checks that the binary $1, built for arch $2, reports version
# $3.
check_binary() {
	local reported
	reported=$(arch "-$(arch_flag "$2")" "$1" --version) || cant_run "$1" "$2"
	[[ $reported == "kit version $3" ]] || release_fail "$1 reports \"$reported\", not kit version $3."
}

# field is the field $1 of notarytool's JSON answer $2; nothing when it has
# none.
field() {
	plutil -extract "$1" raw -o - - <<<"$2" 2>/dev/null || true
}

# notarise sends the app $1 to Apple's notary service, zipped as $2, waits
# on its answer, and staples the ticket Apple gives to the app.
notarise() {
	local result id status="In Progress" round started elapsed
	ditto -c -k --keepParent "$1" "$2"
	echo "Sending kit.app to Apple's notary service…"
	result=$(xcrun notarytool submit "$2" "${notary[@]}" --no-wait --output-format json || true)
	id=$(field id "$result")
	if [[ -z $id ]]; then
		echo "$result"
		release_fail "notarytool gave no submission id, as its output above says: $unlock_command && xcrun notarytool history ${notary[*]} shows what Apple has."
	fi
	local again="$unlock_command && xcrun notarytool wait $id ${notary[*]} says when Apple has answered, and mint can then be run again."
	for ((round = 1; round <= notary_waits; round++)); do
		echo "Submission $id: waiting on Apple's answer…"
		started=$(release_now)
		result=$(xcrun notarytool wait "$id" "${notary[@]}" --timeout "$notary_wait" --output-format json || true)
		elapsed=$(($(release_now) - started))
		status=$(field status "$result")
		# A wait that ran its time ends with no answer, or in progress; one
		# with no answer well before then failed, as with no network, and
		# waiting again would only fail again.
		if [[ -z $status ]] && ((elapsed < notary_wait - 60)); then
			echo "$result"
			release_fail "notarytool's wait on submission $id failed after $elapsed seconds, as it says above: $again"
		fi
		status=${status:-In Progress}
		[[ $status == "In Progress" ]] || break
	done
	echo "Submission $id: $status"
	if [[ $status == "In Progress" ]]; then
		release_fail "Apple hasn't answered submission $id in about an hour: $again"
	fi
	if [[ $status != Accepted ]]; then
		xcrun notarytool log "$id" "${notary[@]}" || true
		release_fail "Apple's notary service refused kit.app, as its log above says."
	fi
	xcrun stapler staple "$1" || release_fail "stapler couldn't staple Apple's ticket to $1, as it says above."
}

# check_notarised checks the app $1 as a Mac will: its signature whole, its
# ticket stapled, and Gatekeeper accepting it as notarised.
check_notarised() {
	local assessed
	codesign --verify --strict "$1" || release_fail "$1's signature doesn't verify, stapled."
	xcrun stapler validate "$1" || release_fail "$1 has no valid ticket stapled, as stapler says above."
	assessed=$(spctl --assess --type execute --verbose=2 "$1" 2>&1) || {
		echo "$assessed"
		release_fail "Gatekeeper refuses $1, as spctl says above."
	}
	grep -q "source=Notarized Developer ID" <<<"$assessed" || {
		echo "$assessed"
		release_fail "Gatekeeper doesn't take $1 as notarised, as spctl says above."
	}
}

# archive archives the binary $1, named kit, and kit.app at $2 beside it,
# when $2 isn't empty, into $3.
archive() {
	local beside=()
	[[ -z $2 ]] || beside=(-C "$(dirname "$2")" kit.app)
	COPYFILE_DISABLE=1 tar --create --gzip --file "$3" --format ustar \
		--no-mac-metadata --no-xattrs --no-acls --no-fflags \
		--uid 0 --gid 0 --uname root --gname wheel \
		--directory "$(dirname "$1")" kit ${beside[@]+"${beside[@]}"}
}

# check_archive checks kit.app as the archive $1 carries it, unpacked, as
# Homebrew and install.sh unpack it.
check_archive() {
	local into=$work/unpacked
	rm -rf "$into"
	mkdir "$into"
	tar -xzf "$1" -C "$into"
	check_notarised "$into/kit.app"
}

# sum writes the checksums file of version $1's archives in the folder $2.
sum() {
	local names=() arch
	for arch in "${release_arches[@]}"; do
		names+=("$(release_archive "$1" "$arch")")
	done
	(cd "$2" && shasum -a 256 "${names[@]}" | LC_ALL=C sort -k 2) >"$2/$(release_checksums "$1")"
}

# keep keeps the folder $1 as version $2's, in place of what's kept for any
# version: one release is made at a time, and an upload of another that
# finds nothing kept builds it again from its tag.
keep() {
	local kept
	kept=$(release_kept "$2")
	rm -rf "$(dirname "$kept")"
	mkdir -p "$(dirname "$kept")"
	mv "$1" "$kept"
	echo "Kept in $kept:"
	ls -l "$kept"
}

# clean_up removes the checkout built from, and the rest of $work.
clean_up() {
	git worktree remove --force "$work/tree" 2>/dev/null || true
	rm -rf "$work"
}

main() {
	[[ $# -le 2 ]] || usage
	check_platform
	local version ref=${2:-} tag
	if [[ $# -ge 1 ]]; then
		version=$1
		tag=v$version
	else
		version=${MINT_NEW_VERSION:-}
		tag=${MINT_VERSION_TAG:-v$version}
	fi
	check_version "$version"
	cd "$scripts/.."
	release_log release-build "$version"
	if [[ -z $ref ]]; then
		check_head "$tag"
		ref=HEAD
	fi
	local commit
	commit=$(commit_of "$ref")
	unlock_keychain
	check_identity
	check_profile

	work=$(mktemp -d)
	trap clean_up EXIT
	git worktree add --quiet --detach "$work/tree" "$commit"
	echo "Building kit $version from $commit"

	local arch bin app='' archived out=$work/out
	mkdir "$work/bin" "$work/app" "$out"
	if [[ -e $work/tree/cmd/kitapp ]]; then
		build_app "$work/tree" "$version" "$work/app"
		app=$work/app/kit.app
	else
		echo "$commit has no cmd/kitapp: building kit without kit.app, as that tree was."
	fi
	for arch in "${release_arches[@]}"; do
		bin=$work/bin/darwin_$arch/kit
		build "$work/tree" "$version" "$arch" "$bin"
		check_binary "$bin" "$arch" "$version"
	done
	if [[ -n $app ]]; then
		notarise "$app" "$work/notarise.zip"
		check_notarised "$app"
	fi
	for arch in "${release_arches[@]}"; do
		archived=$out/$(release_archive "$version" "$arch")
		archive "$work/bin/darwin_$arch/kit" "$app" "$archived"
		[[ -z $app ]] || check_archive "$archived"
	done
	sum "$version" "$out"
	echo "$commit" >"$out/commit"
	keep "$out" "$version"
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
	main "$@"
fi
